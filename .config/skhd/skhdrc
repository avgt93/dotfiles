# focus window
# p
alt - h : /opt/homebrew/bin/yabai -m window --focus west
alt - j : /opt/homebrew/bin/yabai -m window --focus south
alt - k : /opt/homebrew/bin/yabai -m window --focus north
alt - l : /opt/homebrew/bin/yabai -m window --focus east
alt - z : /opt/homebrew/bin/yabai -m window --focus stack.prev
alt - x : /opt/homebrew/bin/yabai -m window --focus stack.next

# swap window
shift + alt - h : /opt/homebrew/bin/yabai -m window --swap west
shift + alt - j : /opt/homebrew/bin/yabai -m window --swap south
shift + alt - k : /opt/homebrew/bin/yabai -m window --swap north
shift + alt - l : /opt/homebrew/bin/yabai -m window --swap east

# move window
shift + cmd - h : /opt/homebrew/bin/yabai -m window --warp west
shift + cmd - j : /opt/homebrew/bin/yabai -m window --warp south
shift + cmd - k : /opt/homebrew/bin/yabai -m window --warp north
shift + cmd - l : /opt/homebrew/bin/yabai -m window --warp east

# balance windows
shift + alt - 0 : /opt/homebrew/bin/yabai -m space --balance

# window grid layouts
shift + alt - up    : /opt/homebrew/bin/yabai -m window --grid 1:1:0:0:1:1
shift + alt - left  : /opt/homebrew/bin/yabai -m window --grid 1:2:0:0:1:1
shift + alt - right : /opt/homebrew/bin/yabai -m window --grid 1:2:1:0:1:1

# create/destroy desktop
shift + cmd - n : /opt/homebrew/bin/yabai -m space --create && \
                  index="$(/opt/homebrew/bin/yabai -m query --spaces --display | /opt/homebrew/bin/jq 'map(select(."native-fullscreen" == 0))[-1].index')" && \
                  /opt/homebrew/bin/yabai -m window --space "${index}" && \
                  /opt/homebrew/bin/yabai -m space --focus "${index}"

cmd + alt - n : /opt/homebrew/bin/yabai -m space --create && \
                index="$(/opt/homebrew/bin/yabai -m query --spaces --display | /opt/homebrew/bin/jq 'map(select(."native-fullscreen" == 0))[-1].index')" && \
                /opt/homebrew/bin/yabai -m space --focus "${index}"

cmd + alt - w : /opt/homebrew/bin/yabai -m space --destroy

# focus desktop
alt - 1 : /opt/homebrew/bin/yabai -m space --focus 1
alt - 2 : /opt/homebrew/bin/yabai -m space --focus 2
alt - 3 : /opt/homebrew/bin/yabai -m space --focus 3
alt - 4 : /opt/homebrew/bin/yabai -m space --focus 4
alt - 5 : /opt/homebrew/bin/yabai -m space --focus 5
alt - 6 : /opt/homebrew/bin/yabai -m space --focus 6
alt - 7 : /opt/homebrew/bin/yabai -m space --focus 7
alt - 8 : /opt/homebrew/bin/yabai -m space --focus 8
alt - 9 : /opt/homebrew/bin/yabai -m space --focus 9
alt - 0 : /opt/homebrew/bin/yabai -m space --focus 10

# send window to desktop
shift + alt - 1 : /opt/homebrew/bin/yabai -m window --space 1
shift + alt - 2 : /opt/homebrew/bin/yabai -m window --space 2
shift + alt - 3 : /opt/homebrew/bin/yabai -m window --space 3
shift + alt - 4 : /opt/homebrew/bin/yabai -m window --space 4
shift + alt - 5 : /opt/homebrew/bin/yabai -m window --space 5
shift + alt - 6 : /opt/homebrew/bin/yabai -m window --space 6
shift + alt - 7 : /opt/homebrew/bin/yabai -m window --space 7
shift + alt - 8 : /opt/homebrew/bin/yabai -m window --space 8
shift + alt - 9 : /opt/homebrew/bin/yabai -m window --space 9
shift + alt - 0 : /opt/homebrew/bin/yabai -m window --space 10

# focus monitor
ctrl + alt - 1 : /opt/homebrew/bin/yabai -m display --focus 1
ctrl + alt - 2 : /opt/homebrew/bin/yabai -m display --focus 2
ctrl + alt - 3 : /opt/homebrew/bin/yabai -m display --focus 3

# send window to monitor
ctrl + cmd - 1 : /opt/homebrew/bin/yabai -m window --display 1 && /opt/homebrew/bin/yabai -m display --focus 1
ctrl + cmd - 2 : /opt/homebrew/bin/yabai -m window --display 2 && /opt/homebrew/bin/yabai -m display --focus 2
ctrl + cmd - 3 : /opt/homebrew/bin/yabai -m window --display 3 && /opt/homebrew/bin/yabai -m display --focus 3

# move/resize windows
shift + ctrl - a : /opt/homebrew/bin/yabai -m window --move rel:-20:0
shift + ctrl - s : /opt/homebrew/bin/yabai -m window --move rel:0:20
shift + ctrl - w : /opt/homebrew/bin/yabai -m window --move rel:0:-20
shift + ctrl - d : /opt/homebrew/bin/yabai -m window --move rel:20:0

# resize windows
shift + alt - a : /opt/homebrew/bin/yabai -m window --resize left:-20:0
shift + alt - s : /opt/homebrew/bin/yabai -m window --resize bottom:0:20
shift + alt - w : /opt/homebrew/bin/yabai -m window --resize top:0:-20
shift + alt - d : /opt/homebrew/bin/yabai -m window --resize right:20:0

# insert windows
ctrl + alt - h : /opt/homebrew/bin/yabai -m window --insert west
ctrl + alt - j : /opt/homebrew/bin/yabai -m window --insert south
ctrl + alt - k : /opt/homebrew/bin/yabai -m window --insert north
ctrl + alt - l : /opt/homebrew/bin/yabai -m window --insert east

# rotate/mirror
alt - r : /opt/homebrew/bin/yabai -m space --rotate 90
alt - y : /opt/homebrew/bin/yabai -m space --mirror y-axis
alt - x : /opt/homebrew/bin/yabai -m space --mirror x-axis

# toggle
alt - a : /opt/homebrew/bin/yabai -m space --toggle padding && /opt/homebrew/bin/yabai -m space --toggle gap
alt - f : /opt/homebrew/bin/yabai -m window --toggle float && /opt/homebrew/bin/yabai -m window --grid 4:4:1:1:2:2
alt - s : /opt/homebrew/bin/yabai -m window --toggle sticky
#alt - o : /opt/homebrew/bin/yabai -m window --toggle topmost
alt - space : /opt/homebrew/bin/yabai -m window --toggle zoom-fullscreen

# layout
ctrl + alt - a : /opt/homebrew/bin/yabai -m space --layout bsp
ctrl + alt - d : /opt/homebrew/bin/yabai -m space --layout float

# screenshot (area to clipboard)
ctrl + alt - s : screencapture -i -c

# open/focus apps
alt - b : export MOZ_DISABLE_SAFE_MODE_KEY=1; open -n "/Applications/Firefox Developer Edition.app"

# scratchpad
alt - return : scratchpad --toggle alacritty
ctrl - return : open -na /Applications/Alacritty.app --args -e /opt/homebrew/bin/fish
alt - t : scratchpad --toggle telegram
alt - d : scratchpad --toggle discord
alt - o : scratchpad --toggle obsidian
alt - u : scratchpad --toggle slack
alt - m : scratchpad --toggle spotify
alt - e : open /Users/avgt

# close app
alt - q : skhd --key "cmd - q"
